# Copy to `.env` and adapt. Used by compose.yaml.

# Public domain of the server. Caddy automatically requests a TLS certificate for it.
# Locally, use `localhost` (Caddy then generates a self-signed certificate).
DOMAIN=museum.example.org

# Address Let's Encrypt sends certificate expiry alerts to.
ACME_EMAIL=admin@example.org

# PocketBase version. Pinned on purpose: PocketBase is pre-1.0 and makes no
# backwards-compatibility guarantee. Do not switch to `latest`.
PB_VERSION=0.39.10
